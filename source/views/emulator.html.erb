---
layout: false
---

<html>
  <head>
    <title>Commodore 64 Emulator - 64 Bites</title>
        <%= stylesheet_link_tag "application" %>
        <style>
        #x64-canvas {
            width: 75%;
            margin: 0 auto;
        }
            </style>
  </head>
  <body style="position: relative; display: grid; place-items: center;">
  <header class="header">
  <div class="row">
  <a class="header__logo" href="/"></a>
  </div>
</header>

  <span id="loading" style="position: absolute; top:50%; left: 50%; transform: translate(-50%, -50%); color: #fff;">Loading</span>
<canvas id="x64-canvas" style="width: 100%; border: 0px none;"></canvas>
  </body>
  <script type="text/javascript">
  
  console.log("Starting up x64...");
    function postRun() {
    document.getElementById("loading").style.visibility = "hidden";
    console.log("POST RUN");
  }
    function audioDetected() {
    return (typeof Audio === 'function' && new Audio().mozSetup === 'function') ||
      (typeof AudioContext === 'function') ||
      (typeof webkitAudioContext === 'function');
  }
  var keymapBase64 = "";
  function loadFile(fileName, contentsBase64) {
    console.log("Loading file: " + fileName);
    FS.createDataFile('/', fileName, atob(contentsBase64), true, true);

  }
  var canvas = document.getElementById('x64-canvas');
  
  var Module = {
    preRun: [],
    postRun: [postRun],
    arguments: [
      //"-menukey", 999999, 
      '+sound',
    '-VICIIfilter', 0],
    canvas,
  }

  </script> 
  <%= javascript_include_tag "x64" %>
</html>